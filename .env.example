# PowerShell: đọc README để nạp các biến này trước khi chạy Maven.
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
# MySQL local. Tạo database scribble_game trước nếu tài khoản không có quyền CREATE DATABASE.
DB_URL=jdbc:mysql://localhost:3306/scribble_game?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your_local_mysql_password
GAME_DEMO_SEED_ENABLED=false
WS_ALLOWED_ORIGINS=*
# JavaFX: -Dscribble.server=localhost:8080 (có ô nhập địa chỉ trong ứng dụng).
